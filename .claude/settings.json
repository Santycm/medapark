      "Bash(supabase migration:*)",
      "Bash(npx supabase test db:*)",
      "Bash(supabase test db:*)",
      "Bash(npx supabase config push:*)",
      "Bash(supabase config push:*)",
      "Bash(npx supabase functions deploy:*)",
      "Bash(supabase functions deploy:*)",
      "Bash(npx supabase secrets:*)",
      "Bash(supabase secrets:*)",
      "Bash(npx supabase db query:*)",
      "Bash(supabase db query:*)",
      "Bash(npx supabase link:*)",
      "Bash(supabase link:*)"
    ]
  }
